<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Multichain third-party licenses</title>
  <style>
    body {
      font-family: ui-sans-serif, system-ui, sans-serif;
      line-height: 1.5;
      margin: 0 auto;
      max-width: 72rem;
      padding: 2rem;
    }
    pre {
      border: 1px solid #bbb;
      max-height: 24rem;
      overflow: auto;
      padding: 1rem;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>
  <main>
    <h1>Multichain third-party licenses</h1>
    <p>
      Generated from the locked Rust dependency graph for the accompanying
      Multichain release.
    </p>
    <h2>License overview</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}} packages)</li>
      {{/each}}
    </ul>
    <h2>License texts and packages</h2>
    {{#each licenses}}
    <section>
      <h3 id="{{id}}">{{name}}</h3>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
        <li>
          <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">
            {{crate.name}} {{crate.version}}
          </a>
        </li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
